# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Gunakan Supabase transaction pooler (port 6543) untuk Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel

# Service role key hanya untuk server. Jangan gunakan awalan NEXT_PUBLIC_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nikenbakery-media

# Hanya untuk migrasi data lama SQLite -> Supabase, tidak dipakai aplikasi runtime.
SQLITE_SOURCE_PATH=./data/nikenbakery.db
SQLITE_UPLOAD_DIR=./data/uploads

# Minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hanya dipakai script `npm run admin:create`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
