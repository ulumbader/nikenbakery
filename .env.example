# Salin ke .env.local. Rahasia tidak boleh diawali NEXT_PUBLIC_ atau di-commit.
# Gunakan connection string Supabase dari Connect → Transaction pooler untuk Vercel.
DATABASE_URL=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Hanya dibutuhkan selama impor data lama dari SQLite dan file unggahan lokal.
DB_PATH=./data/nikenbakery.db
UPLOAD_DIR=./data/uploads

# Minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hanya dipakai script `npm run admin:create`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
